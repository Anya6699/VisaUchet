@startuml
' Рисунок 2.1 – Диаграмма деятельности «Регистрация заявки» (один конечный узел)
!include _style.iuml
|Оператор приёма|
start
:Открыть форму Ф1;
repeat
  :Ввести (исправить) данные;
  if () then ([«Зарегистрировать»])
    |Система «ВизаУчет»|
    :Проверить данные заявки;
    if () then ([есть ошибки])
      :Показать ошибки у полей;
    else ([ошибок нет])
      :Проверить срок
      действия паспорта;
      if () then ([срок паспорта\nнедостаточен])
        :Отклонить регистрацию
        с сообщением;
      else ([срок паспорта\nдостаточен])
        :Найти заявителя
        среди существующих;
        if () then ([заявитель найден])
          |Оператор приёма|
          :Подтвердить использование
          данных заявителя;
        else ([заявитель не найден])
          |Система «ВизаУчет»|
          :Создать нового
          заявителя;
        endif
        |Система «ВизаУчет»|
        :Присвоить номер, статус
        и контрольный срок;
        :Открыть карточку заявки;
      endif
    endif
  else ([«Выйти без регистрации»])
    |Оператор приёма|
    :Закрыть форму
    без регистрации;
  endif
|Система «ВизаУчет»|
repeat while () is ([есть ошибки]) not ([иначе])
stop
@enduml
