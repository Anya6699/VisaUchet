<Project Sdk="Microsoft.NET.Sdk">
  <!-- Desktop client (Windows Forms): forms Ф1–Ф5, login and user administration -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>VisaUchet.WinForms</RootNamespace>
    <AssemblyName>VisaUchet</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- UI analyzers may differ between SDK versions; warnings must not block the build -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VisaUchet.Infrastructure\VisaUchet.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
