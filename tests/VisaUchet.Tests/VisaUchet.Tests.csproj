<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests of the domain and business logic (xUnit) -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit analyzers differ between package versions; warnings must not block the tests -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\VisaUchet.Domain\VisaUchet.Domain.csproj" />
    <ProjectReference Include="..\..\src\VisaUchet.Application\VisaUchet.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="VisaUchet.Domain" />
  </ItemGroup>
</Project>
